# Choix des compilateurs de la toolchain
CXX      := x86_64-w64-mingw32-g++
CXXFLAGS := -std=c++26 -fpermissive -Wall
LDFLAGS  := -shared -static -luser32 -lkernel32

# Détection dynamique du linker (équivalent du find_program de CMake)
# MOLD_PATH va contenir le chemin vers 'mold' s'il existe dans le PATH, sinon chaîne vide
MOLD_PATH := $(shell command -v mold 2> /dev/null)

ifneq ($(MOLD_PATH),)
    # mold est présent sur le système hôte, on l'injecte dans le linker
    LDFLAGS += -fuse-ld=mold
endif

# Règle de compilation/linking
main.dll: main.cpp
	$(CXX) $(CXXFLAGS) main.cpp -o $@ $(LDFLAGS)

clean:
	rm -f main.dll
